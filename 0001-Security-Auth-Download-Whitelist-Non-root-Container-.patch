@@ -653,8 +716,17 @@ def status(job_id):
         return jsonify(JOBS[job_id])
 
 
+# Nur die erzeugten Ausgabedateien direkt im Job-Ordner – niemals pki/ (CA-/Server-Keys)
+DOWNLOAD_RE = re.compile(
+    r"^job-[0-9a-f]{32}/[A-Za-z0-9_-]+(\.ovpn|_install_readme\.txt|\.zip)$"
+    r"|^job-[0-9a-f]{32}/(install_readme\.txt|crl\.pem)$"
+)
+
+
 @app.route("/download/<path:filepath>")
 def download(filepath):
+    if not DOWNLOAD_RE.match(filepath):
+        return "Zugriff verweigert", 403
     try:
         full = (BASE_JOBS_DIR / filepath).resolve()
         base = BASE_JOBS_DIR.resolve()
@@ -683,4 +755,4 @@ def _cleanup() -> None:
 threading.Thread(target=_cleanup, daemon=True).start()
 
 if __name__ == "__main__":
-    app.run(host="0.0.0.0", port=9192, threaded=True)
+    app.run(host=os.environ.get("VPNGEN_BIND", "0.0.0.0"), port=9192, threaded=True)
