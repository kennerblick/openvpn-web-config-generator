 def make_job() -> tuple[str, dict]:
-    jid = f"job-{uuid.uuid4().hex[:8]}"
+    jid = f"job-{secrets.token_hex(16)}"
     status: dict = {
         "state": "running", "progress": 0, "message": "Starte...",
         "encrypt_key": True, "clients": [],
@@ -64,7 +104,9 @@ def generate_password(length: int = 16) -> str:
 
 
 def sanitize_client(name: str) -> str:
-    return re.sub(r"[^a-zA-Z0-9_-]", "", name)[:32] or "client"
+    clean = re.sub(r"[^a-zA-Z0-9_-]", "", name)[:32] or "client"
+    # "server"/"ca" würden mit den PKI-Dateien des Servers kollidieren
+    return f"client-{clean}" if clean.lower() in RESERVED_NAMES else clean
 
 
